# ─── PROKERALA API (Optional — Vedic Astrology Integration) ───────────────────
# Register free at: https://api.prokerala.com/get-api-token
# Leave empty to use offline astronomy-engine
# NOTE: VITE_ variables are bundled into client-side JS. Do NOT ship private secrets in client builds.
VITE_PROKERALA_CLIENT_ID=your_prokerala_client_id_here
VITE_PROKERALA_CLIENT_SECRET=your_prokerala_client_secret_here

# ─── SUPABASE (Optional — Cloud Chart Storage) ───────────────────────────────
# Register free at: https://supabase.com
# Project Settings → API → copy Project URL and anon/public key
# Leave empty to disable cloud chart saving feature
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

